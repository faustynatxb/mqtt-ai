# OpenRouter — required by main.py
OPENROUTER_API_KEY=replace_with_your_openrouter_key
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# MQTT — required only by mqtt_client.py
MQTT_HOST=replace_with_your_broker_host
MQTT_PORT=8883
MQTT_USERNAME=replace_with_your_broker_username
MQTT_PASSWORD=replace_with_your_broker_password
MQTT_DEVICE_ID=esp32-001
